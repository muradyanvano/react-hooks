{
  "name": "@muradyanvano/react-hooks",
  "version": "1.0.0",
  "description": "Production-oriented React hooks library for React 18 and 19.",
  "type": "module",
  "author": "Vano Muradyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muradyanvano1995/react-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/muradyanvano1995/react-hooks/issues"
  },
  "homepage": "https://muradyanvano1995.github.io/react-hooks/",
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "typescript",
    "esm",
    "ssr",
    "utility-hooks"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.8.0",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:lib",
    "build:lib": "vite build",
    "build:storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:storybook": "vitest run --project=storybook",
    "test:layout": "node scripts/storybook-layout-audit.mjs",
    "test:reset": "node scripts/storybook-reset-audit.mjs",
    "test:ssr:react18": "node scripts/test-ssr-react18.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "validate:release": "node scripts/validate-release.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run build:storybook",
    "verify:ci": "npm run verify && npm run test:storybook && npm run test:ssr:react18"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@microsoft/api-extractor": "^7.59.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
